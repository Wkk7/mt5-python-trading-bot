# Copy this file to .env and edit the values

SYMBOLS=EURUSD,GBPUSD
TIMEFRAME=H1
# % of balance risked per trade
RISK_PCT=0.5
# stop opening trades after -3% in one day
MAX_DAILY_LOSS_PCT=3
# only open trades between these UTC hours
TRADE_HOURS_UTC=7-20
# id used to recognise the bot's own positions
MAGIC=770077
# true = log only, false = send real orders (test on a DEMO account first!)
DRY_RUN=true

# Optional Telegram alerts (create a bot with @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: path to terminal64.exe if you have more than one MT5 installed
MT5_PATH=
